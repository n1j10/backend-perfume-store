{
  "name": "book-store-api",
  "version": "1.0.0",
  "description": "Express REST API for the book store (ported from Next.js server actions)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "test": "node --test tests/",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@clerk/express": "^1.3.0",
    "@prisma/client": "6.1.0",
    "cors": "2.8.5",
    "dotenv": "^16.6.1",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "morgan": "1.10.0",
    "multer": "2.0.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "nodemon": "3.1.9",
    "prisma": "6.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
