PORT=5000
NODE_ENV=development

# Frontend URL (CORS + redirect after payment)
CLIENT_URL=http://localhost:3000
# Public URL of this API (QiCard sends the user and the webhook here)
SERVER_URL=http://localhost:5000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
ADMIN_USER_ID=user_xxx

# Neon Storage (S3 compatible)
AWS_ENDPOINT_URL_S3=https://your-branch.storage.neon.tech
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=book-store-images

# QiCard Payment Gateway
QICARD_BASE_URL=https://uat-sandbox-3ds-api.qi.iq/api/v1
QICARD_USERNAME=xxx
QICARD_PASSWORD=xxx
QICARD_TERMINAL_ID=xxx
QICARD_PUBLIC_KEY=
